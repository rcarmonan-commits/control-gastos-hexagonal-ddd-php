# Configuracion general de la aplicacion
APP_NAME="Sistema de Control de Usuarios y Gastos - Hexagonal DDD CQRS"
APP_ENV=local
APP_DEBUG=true
APP_PORT=8080

# Estrategia de persistencia: mysql | memory
PERSISTENCE_DRIVER=mysql

# Credenciales de Base de Datos (Local / Docker / Nube: Aiven, Railway, TiDB Cloud)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crud_usuarios
DB_USERNAME=Estudiante
DB_PASSWORD=Developer
DB_CHARSET=utf8mb4
DB_SSL_CA=

# Configuracion de Cache y Cola de Eventos
CACHE_TTL_SECONDS=60
TAX_DEFAULT_IVA_RATE=0.19
